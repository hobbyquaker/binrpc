{
  "version": "4.1.0",
  "name": "binrpc",
  "description": "HomeMatic binary RPC protocol - xmlrpc_bin://",
  "homepage": "https://github.com/hobbyquaker/binrpc",
  "author": "Sebastian 'hobbyquaker' Raff <hobbyquaker@gmail.com>",
  "contributors": [
    "Ingo 'Apollon77' Fischer (https://github.com/Apollon77)",
    "Mik- https://github.com/Mik-",
    "Vegetto https://github.com/angelnu",
    "Benjamin Kroeger https://github.com/benkroeger",
    "Thomas Wendt https://github.com/twendt"
  ],
  "keywords": [
    "HomeMatic",
    "binrpc",
    "xmlrpc_bin",
    "BidCos",
    "CUxD",
    "Homegear",
    "rfd",
    "hs485d"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/binrpc.git"
  },
  "main": "./lib/binrpc.js",
  "files": [
    "lib/"
  ],
  "bugs": {
    "url": "https://github.com/hobbyquaker/binrpc/issues"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test --test-force-exit tests/*.js",
    "test:watch": "node --test --watch tests/*.js",
    "docs": "jsdoc2md lib/*.js > doc/api.md && cat doc/README.header.md doc/api.md doc/README.footer.md > README.md"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "jsdoc-to-markdown": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "engines": {
    "node": ">=20"
  }
}
